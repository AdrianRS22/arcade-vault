# Contact form (About page) — server only, never prefix with NEXT_PUBLIC_
# Copy this file to .env.local and fill in the values.

# Resend API key (https://resend.com/api-keys), e.g. re_xxx
RESEND_API_KEY=

# Team inbox that receives the messages.
# Without a verified domain, Resend only delivers to the email of the Resend account owner.
CONTACT_TO_EMAIL=

# Sender. The test sender works without a verified domain,
# e.g. Arcade Vault <onboarding@resend.dev>
CONTACT_FROM_EMAIL=

# Supabase database password — server only, never prefix with NEXT_PUBLIC_
# Set when creating the project; reset it in Supabase Dashboard > Project Settings > Database.
SUPABASE_DB_PASSWORD=
