# Contact form (About page) — server only, never prefix with NEXT_PUBLIC_
# Copy this file to .env.local and fill in the values.

# Resend API key (https://resend.com/api-keys), e.g. re_xxx
RESEND_API_KEY=

# Team inbox that receives the messages.
# Without a verified domain, Resend only delivers to the email of the Resend account owner.
CONTACT_TO_EMAIL=

# Sender. The test sender works without a verified domain,
# e.g. Arcade Vault <onboarding@resend.dev>
CONTACT_FROM_EMAIL=

# Supabase project API URL (Supabase Dashboard > Project Settings > API),
# e.g. https://<project-ref>.supabase.co
# Public by design: it is read by the browser client too.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key, e.g. sb_publishable_xxx
# (Supabase Dashboard > Project Settings > API Keys).
# Public by design: safe in the browser as long as RLS is enabled on every table.
# Never put the secret / service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase personal access token — used only by the Supabase CLI (`supabase link`,
# `db:types`, `db:push`). Server/CLI only, never prefix with NEXT_PUBLIC_.
# Create it in Supabase Dashboard > Account > Access Tokens.
SUPABASE_ACCESS_TOKEN=

# Production read-only connection (Supabase Session pooler, port 5432), used with psql
# for read-only queries. Role `claude_readonly` (SELECT only, read-only sessions).
# Server/CLI only, never prefix with NEXT_PUBLIC_. Keep the real value in .env.local only.
# e.g. postgresql://claude_readonly.<PROD_REF>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
PROD_RO_DB_URL=
