{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-and-lint.mjs\"",
            "timeout": 60,
            "statusMessage": "Prettier + ESLint..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(*supabase link*)",
      "Bash(*supabase config push*)",
      "Bash(*--db-url*)",
      "PowerShell(*supabase link*)",
      "PowerShell(*supabase config push*)",
      "PowerShell(*--db-url*)",
      "Read(.env.production*)",
      "Read(**/.env.production*)"
    ]
  },
  "enabledPlugins": {
    "security-guidance@anthropic-plugin-directory": true
  }
}
